# ------------------------------------------------------------------
# SRMS - Student Record Management System  (backend configuration)
# ------------------------------------------------------------------

# Server port
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/srms

# Administrator login credentials (kept on the server only - never in the frontend)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator

# Development helper:
# true  -> start a temporary, real MongoDB instance in-process
#          (useful when MongoDB is not installed on the machine)
# false -> use MONGODB_URI above (normal setup with MongoDB installed)
USE_MEMORY_DB=false

# Insert the four sample students automatically when the students
# collection is empty on server start
SEED_SAMPLE_DATA=true